  "info": {
    "description": "SDK PHP pour l'API BLUP de Beekube - Calcul génétique des abeilles mellifères",
    "title": "Beekube BLUP Mellifera API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "welcome__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WelcomeResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Welcome endpoint",
        "tags": [
          "blup"
        ]
      }
    },
    "/blup": {
      "post": {
        "operationId": "calulate_blup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BLUPInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BLUPOutput"
                }
              }
            },
            "description": "OK"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ValidationErrorModel"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Perform BLUP calculation",
        "tags": [
          "blup"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "https://mellifera.beekube.com"
    }
  ],
  "tags": [
    {
      "description": "BLUP operations",
      "name": "blup"
    }
  ]
}
