FROM r-base:4.4.1


# Installer les dépendances système
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcurl4-openssl-dev \
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    cmake \
    libxml2-dev \
    libgsl-dev \
    libpng-dev \
    libfontconfig1-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libfreetype6-dev \
    libtiff5-dev \
    libjpeg-dev

WORKDIR /app

COPY ./requirements-bin.txt .

RUN cat requirements-bin.txt | xargs apt-get install -y -qq

RUN ln -s /usr/bin/python3 /usr/bin/python

# Créer et activer un environnement virtuel
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN chmod -R 755 /usr/local/lib/R/site-library

COPY requirements.txt .
RUN pip install -r requirements.txt

# Copier le script R dans l'image
COPY blup.r .
COPY app.py .
COPY blup2 ./blup2
COPY tests ./tests

EXPOSE 8081

CMD ["gunicorn", "--bind", "0.0.0.0:8081", "--workers", "2", "--timeout", "180", "app:app"]